# CarePulse F-03 — variable NAMES and placeholders only; never use as an active policy.
# Copy to an ignored .env only in a disposable synthetic development environment.
# Explicit policy numerics remain OPEN for production; no real-user deployment.
CP_ENV=development
CP_SYNTHETIC_TEST_PROFILE=true
CP_ACTIVE_POLICY_SOURCE_FILE=tests/fixtures/foundation-policy.json
CP_DB_HOST=db
CP_DB_PORT=5432
CP_DB_NAME=carepulse
CP_DB_USER=carepulse_runtime
CP_AUTH_DB_USER=carepulse_auth
CP_INTERNAL_API_URL=http://api:8000
# Non-secret identifier for the active server-side BFF/API HMAC key (must match).
CP_SIGNING_KEY_ID=synthetic-v1
# Current fingerprint HMAC is derived from the BFF auth secret mounted at /run/secrets/auth_secret.
# Keep the exact version and old secret files available while matching resets are retriable.
CP_RECOVERY_FINGERPRINT_KEY_VERSION=synthetic-v1
# Optional prior-version entries; mount every referenced file into Web as read-only secret.
# CP_RECOVERY_FINGERPRINT_RETAINED_KEY_FILES=synthetic-old-v1=/run/secrets/retained_auth_secret
CP_MAIL_ENABLED=false
CP_SCAN_ENABLED=false

# Each variable below must point to an existing UNTRACKED read-only file.
# The bootstrap password is CI/disposable DB only, not a runtime credential.
CP_DB_PASSWORD_FILE=<ignored-bootstrap-password-file>
CP_RUNTIME_DB_PASSWORD_FILE=<ignored-runtime-db-password-file>
CP_AUTH_DB_PASSWORD_SOURCE_FILE=<ignored-web-auth-db-password-file>
CP_SERVICE_KEY_SOURCE_FILE=<ignored-service-key-file>
CP_AUTH_SECRET_SOURCE_FILE=<ignored-web-auth-secret-file>
CP_FILE_ENCRYPTION_KEY_SOURCE_FILE=<ignored-file-key-file>

# Operator profile only; never supply these to web/API/regular worker.
# CP_DB_USER=carepulse_operator
# CP_OPERATOR_DB_PASSWORD_FILE=<ignored-operator-db-password-file>
# CP_OPERATOR_CREDENTIAL_FILE=<ignored-individual-operator-secret-file>
# CP_DELIVERY_PUBLIC_KEY_FILE=<ignored-rsa3072-public-pem-file>
# CP_DELIVERY_KEY_ID=<synthetic-key-id>

# Sender profile only; source private key never mounts in operator or web.
# CP_DB_USER=carepulse_sender
# CP_SENDER_DB_PASSWORD_FILE=<ignored-sender-db-password-file>
# CP_DELIVERY_PRIVATE_KEY_FILE=<ignored-rsa3072-private-pem-file>
# CP_DELIVERY_LEASE_SECONDS=<approved-synthetic-positive-integer>
# CP_DELIVERY_ATTEMPT_TIMEOUT_SECONDS=<approved-synthetic-positive-integer-less-than-lease>
# CP_DELIVERY_MAX_ATTEMPTS=<approved-synthetic-positive-integer>
# CP_DELIVERY_RETRY_SECONDS=<approved-synthetic-positive-integer>
# CP_MAIL_BASE_URL=<allowlisted-synthetic-origin>
